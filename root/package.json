{
  "name": "vexora-bot-suite",
  "version": "1.0.0",
  "description": "Vexora — Multi-purpose Discord utility, moderation, security, leveling, engagement, and economy bot with web dashboard.",
  "main": "bot/index.js",
  "type": "module",
  "scripts": {
    "start:bot": "node bot/index.js",
    "start:api": "node dashboard/api/server.js",
    "dev:bot": "node --watch bot/index.js",
    "dev:api": "node --watch dashboard/api/server.js",
    "lint": "node --check bot/index.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "moderation",
    "utility",
    "economy",
    "leveling",
    "anti-nuke",
    "dashboard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
