# ==========================================
# VEXORA DISCORD BOT & DASHBOARD ENV CONFIG
# ==========================================

# Bot Core
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_CLIENT_SECRET=your_discord_application_client_secret_here
DEFAULT_PREFIX=!
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en-US

# Dashboard & Session
DASHBOARD_URL=http://localhost:3000
API_PORT=3001
SESSION_SECRET=replace_with_a_strong_random_session_secret
OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/callback
ADMIN_USER_IDS=

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vexora?retryWrites=true&w=majority
MONGODB_DB_NAME=vexora

# Social Feeds & External APIs (Optional / As Needed)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FUN_MEDIA_API_KEY=

# Logging & Error Alerts
ERROR_WEBHOOK_URL=
LOG_LEVEL=info
